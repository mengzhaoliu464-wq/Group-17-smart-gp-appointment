/></Array></mxGeometry></mxCell><mxCell id="c104" value="Session ends" style="points=[];shape=mxgraph.bpmn.event;html=1;outline=end;symbol=general;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;" vertex="1" parent="c7"><mxGeometry x="690.0" y="57.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="c105" value="No" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=7;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c100" target="c104"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c106" value="Each status change (Completed / No-show / Cancelled)&lt;br&gt;is written to D1 and feeds the analytics dashboard (FR-16, FR-17)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="804.0" y="676.0" width="381.6" height="34.0" as="geometry"/></mxCell><mxCell id="c107" value="BPMN 2.0 notation – pools/lanes = participants, thin circle = start event, bold circle = end event, double circle = intermediate event, diamond X = exclusive gateway, diamond + = parallel gateway, solid arrow = sequence flow, dashed arrow = message flow, dotted arrow = data association, cylinder = data store." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="6.0" y="3.0" width="1150.0" height="47.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>